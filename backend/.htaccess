Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Keep private Laravel files behind the public front controller on shared hosting.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    # Stop the root rules from processing requests already rewritten into public/.
    RewriteRule ^public(?:/|$) - [L]

    # Keep certificate-validation files available from the domain root.
    RewriteRule ^\.well-known(?:/|$) - [L]

    # Teacher profiles are database-managed and must never fall back to stale exported HTML.
    RewriteRule ^(?:ar/)?teachers/[^/]+/?$ public/index.php [L,QSA]

    # Serve the prebuilt homepage and clean static page routes without booting PHP.
    RewriteRule ^$ public/site/index.html [L]

    RewriteCond %{DOCUMENT_ROOT}/public/$1/index.html -f
    RewriteRule ^(?!api(?:/|$)|admin(?:/|$)|livewire(?:/|$)|up$)(.+?)/?$ public/$1/index.html [L]

    # Serve real public assets directly. Route APIs and Filament through Laravel.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]
    RewriteRule ^ public/index.php [L]
</IfModule>

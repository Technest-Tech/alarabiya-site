Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Keep private Laravel files behind the public front controller on shared hosting.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    # Stop the root rules from processing requests already rewritten into public/.
    RewriteRule ^public(?:/|$) - [L]

    # Keep certificate-validation files available from the domain root.
    RewriteRule ^\.well-known(?:/|$) - [L]

    # Serve real public assets directly. Route pages, APIs, and Filament through Laravel.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]
    RewriteRule ^ public/index.php [L]
</IfModule>
